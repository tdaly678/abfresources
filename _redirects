# Cloudflare Pages routing for the tab URLs (added 2026-08-05).
# 200 = rewrite: the URL stays in the address bar and index.html is served;
# the in-page router (see "URL Routing" section of index.html) opens the
# matching tab. Anything NOT listed here still falls through to 404.html,
# which handles the numeric feedback short codes (/12345 -> /?f=12345).

# Trailing-slash variants -> canonical (no trailing slash)
/classes/     /classes     301
/abfs/        /abfs        301
/key-dates/   /key-dates   301
/videos/      /videos      301
/teachers/    /teachers    301
/courses/     /courses     301
/special-visits/ /special-visits 301
/scheduling/  /scheduling  301
/feedback/    /feedback    301

# Friendly aliases
# NOTE: do NOT add trailing-slash-stripping rules for real directories like
# /corebeliefs-questions/ — Cloudflare Pages already 307s /foo -> /foo/ for a
# directory index, so a /foo/ -> /foo rule here creates a redirect loop. The
# tab routes above are safe because they are rewrites, not real directories.
/cbquestions  /corebeliefs-questions/  301
/cbquestions/ /corebeliefs-questions/  301
/dates        /key-dates   301
/dates/       /key-dates   301
/leaders      /abfs        301
/leaders/     /abfs        301
/resources    /videos      301
/resources/   /videos      301
/mobilization  /special-visits  301
/mobilization/ /special-visits  301

# Tab routes -> the single-page hub
/classes      /            200
/abfs         /            200
/key-dates    /            200
/videos       /            200
/teachers     /            200
/courses      /            200
/special-visits /          200
/scheduling   /            200
/feedback     /            200
